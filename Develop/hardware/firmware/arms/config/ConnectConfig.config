# ============================================
# PCA9685 Servo Controller Configuration
# Robot Arms - Connection Config
# ============================================

# I2C Connection Pins (Arduino Uno)
[I2C]
SCL_PIN = A5
SDA_PIN = A4

# PCA9685 Configuration
[PCA9685]
ADDRESS = 0x40
PWM_FREQUENCY = 50

# Servo Configuration
[SERVO]
# Channel on PCA9685 (0-15)
CHANNEL = 5

# PWM Pulse Range (microseconds)
# Adjust according to your servo type
# SG90: 500-2400
# MG996R: 500-2500
# DS3218: 500-2500
MIN_PULSE_US = 500
MAX_PULSE_US = 2500

# Rotation step per command (degrees)
ROTATION_STEP = 5

# Angle limits (degrees, relative to origin)
MIN_ANGLE = -90
MAX_ANGLE = 90

# Serial Communication
[SERIAL]
BAUD_RATE = 115200

# ============================================
# Wiring Diagram:
# 
# Arduino Uno      PCA9685
# -----------      --------
# A5 (SCL)  -----> SCL
# A4 (SDA)  -----> SDA
# 5V        -----> VCC
# GND       -----> GND
# 
# PCA9685          Servo
# --------         -------
# PWM5     ------> Signal (Orange/Yellow)
# V+       ------> Power (Red) [External 5-6V]
# GND      ------> Ground (Brown/Black)
#
# Note: Use external power supply for servo via V+ terminal
#       on PCA9685 (5-6V, sufficient current for servo)
# ============================================

# ============================================
# Serial Commands:
# LEFT/L   - Rotate 5 degrees left
# RIGHT/R  - Rotate 5 degrees right  
# RESET/0  - Return to origin (0 degrees)
# POS/P    - Get current position
# ANGLE n  - Move to angle n (-90 to 90)
# STOP/Q   - Stop servo and halt program
# HELP/H   - Show help
# ============================================