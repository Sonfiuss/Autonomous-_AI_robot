// ============================================
// Ultrasonic Radar Configuration
// Arduino Uno + HC-SR04 + PCA9685 Servo
// ============================================

// Ultrasonic Sensor Pins
constexpr uint8_t kTriggerPin = 9;
constexpr uint8_t kEchoPin = 10;
constexpr unsigned long kEchoTimeoutUs = 30000UL;

// PCA9685 Configuration
constexpr uint8_t kPCA9685Address = 0x40;
constexpr uint8_t kServoChannel = 15;
constexpr uint16_t kPWMFrequency = 50;

// Servo PWM Pulse Range (microseconds)
constexpr uint16_t kServoMinPulseUs = 500;
constexpr uint16_t kServoMaxPulseUs = 2500;

// Radar Sweep Configuration
// Speed: 0.5 rad/s = ~28.6 deg/s
constexpr float kServoSpeedRadPerSec = 0.5F;
constexpr float kServoSpeedDegPerSec = 28.6479F;  // 0.5 * 180 / PI
constexpr int kMinAngle = -30;
constexpr int kMaxAngle = 30;

// Sweep step (degrees per reading)
constexpr int kSweepStepDeg = 1;

// Delay between steps (ms) = step / speed * 1000
// 1 deg / 28.6479 deg/s * 1000 = ~35ms
constexpr unsigned long kStepDelayMs = 35UL;

// Maximum detection range (cm)
constexpr float kMaxRangeCm = 400.0F;

