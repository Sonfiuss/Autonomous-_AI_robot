<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>slam_bringup</name>
  <version>0.1.0</version>
  <description>Launch files + static camera extrinsics for the RTAB-Map mono RGB-D
  SLAM stack (camera, serial_bridge, depth_anything_node, TF, rtabmap).</description>
  <maintainer email="hthaison17@gmail.com">Sonfiuss</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>serial_bridge</exec_depend>
  <exec_depend>depth_anything_node</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rtabmap_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
