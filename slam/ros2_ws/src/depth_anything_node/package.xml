<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>depth_anything_node</name>
  <version>0.1.0</version>
  <description>Mono RGB-D: runs Depth Anything V2 on /rgb/image_raw and publishes
  metric depth on /depth/image_raw (32FC1), scaled by k from scale.yaml. Reuses the
  deepmap / depth-anything pipeline (no code copy).</description>
  <maintainer email="hthaison17@gmail.com">Sonfiuss</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
