{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/nvidia/Documents/agent/scripts/context_loader.sh",
            "statusMessage": "Loading robot project context..."
          },
          {
            "type": "command",
            "command": "bash /home/nvidia/Documents/agent/scripts/review_reset.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/nvidia/Documents/agent/scripts/review_flag.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/nvidia/Documents/agent/scripts/session_logger.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash /home/nvidia/Documents/agent/scripts/review_gate.sh"
          }
        ]
      }
    ]
  }
}
